# Create a free app at https://developer.spotify.com/dashboard to get these.
# Client Credentials flow only — no user login/redirect URI needed.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Used as the User-Agent for MusicBrainz API calls, per their usage policy:
# https://musicbrainz.org/doc/MusicBrainz_API/Rate_Limiting
MUSICBRAINZ_CONTACT_EMAIL=
