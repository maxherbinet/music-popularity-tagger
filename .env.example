# Fallback chain of popularity sources, tried in order (see --sources).
# Deezer needs nothing below — any source whose credentials are blank here
# is skipped automatically, no need to comment it out.

# Free, instant, self-serve key — no app review: https://www.last.fm/api/account/create
LASTFM_API_KEY=

# Free, instant, self-serve token — no app review: https://www.discogs.com/settings/developers
DISCOGS_TOKEN=

# Only needed for --sources including "spotify". Client Credentials flow —
# no user login/redirect URI needed, just create a free app:
# https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Used as the User-Agent/contact for MusicBrainz + Discogs API calls, per
# their usage policies. Just a text string, not an account — any email works:
# https://musicbrainz.org/doc/MusicBrainz_API/Rate_Limiting
MUSICBRAINZ_CONTACT_EMAIL=
